flowchart TD
    A[main.py Entry] --> B[Logging + Imports]
    B --> C[EDIATHSystem Init]
    C --> D[Orchestrator Config Load]
    D --> E[Async initialize]
    
    subgraph INIT_SEQ [Initialization Sequence]
        E --> E1[Validate Deps]
        E1 --> E2[Rate Limiter]
        E2 --> E3[Task Queue Manager<br/>AI/Automation/Learning Queues]
        E3 --> E4[Orchestrator Init]
        E4 --> E5[LLM Engine<br/>CRITICAL - ollama/gguf]
        E5 --> E6[Executor + File Manager]
        E6 --> E7[Audio: Speaker/Wakeword/Listener]
        E7 --> E8[Vision Engine Optional]
        E8 --> E9[System READY]
    end
    
    E9 --> F[Main Modes]
    F -->|UI Mode| G[Kivy App + DashboardScreen]
    F -->|Backend Mode| H[Voice Loop + Autonomous Loops]
    
    subgraph INPUT_PROCESSING [User Input Flow]
        I[User Input<br/>Text/Voice/Vision] --> J[filter_and_process<br/>Content Filter]
        J --> K[Intent Classifier]
        K --> L[Action Router]
        L --> M[Router: Agent Selection<br/>20+ Specialized Agents]
        M -->|search_agent| N1[Search Agent]
        M -->|code_agent| N2[Code Execution Agent]
        M -->|file_agent| N3[File Agent]
        M -->|default| N4[RAgent Core]
        N1 -.->|All agents| O[LLM Engine + Brain<br/>DecisionEngine]
        N2 -.-> O
        N3 -.-> O
        N4 -.-> O
        O --> P[Response Generation]
        P --> Q[UI Message + Speak]
    end
    
    subgraph AUTONOMOUS [Autonomous Systems]
        R[Task Queues<br/>AI/automation/learning] 
        R --> S[Worker Handlers<br/>ai_handler/auto_handler/learn_handler]
        S --> T[Rate Limited Execution]
        
        U[AutonomousLoop]
        U --> V[BackgroundThinker]
        V --> W[CuriosityEngine]
        W --> X[GoalManager]
        X --> Y[SelfImprovement]
        
        Z[AutonomousCoreEngine]
        Z --> AA[SoftwareBuilder]
        
        BB[Perception Loop<br/>Vision/Audio]
    end
    
    subgraph AGENTS [Agent Ecosystem ~25 Agents]
        AC[automation_agent]
        AD[browse_agent]
        AE[codeexecution_agent]
        AF[research_agent]
        AG[shell_agent]
        AH[speech_agent]
        AI[vision_agent]
        AJ[planner]
        AK[critic_agent]
        AL[knowledge_base_agent]
        AC -.->| Routed via| M
        AD -.-> M
        AE -.-> M
        AF -.-> M
        AG -.-> M
        AH -.-> M
        AI -.-> M
        AJ -.-> M
        AK -.-> M
        AL -.-> M
    end
    
    subgraph UI [Kivy UI]
        G --> BA[ChatPanel]
        G --> BB[StatusBar]
        G --> BC[Task Display]
        G --> BD[Memory Graph]
        G --> BE[System Stats]
    end
    
    subgraph SHUTDOWN [Graceful Shutdown]
        BF[shutdown] --> BG[Stop Listeners/Speaker]
        BG --> BH[Shutdown RateLimiter]
        BH --> BI[Shutdown TaskQueue]
        BI --> BJ[Orchestrator Shutdown]
        BJ --> BK[Vision Stop]
        BK --> BL[Cancel Tasks]
        BL --> BM[System Stopped]
    end
    
    H -.->|Triggers| I
    Q -.->|Feedback| R
    Q -.->|Memory| CN[MemoryManager<br/>Episodic/Semantic/Vector]
    
    style A fill:#e1f5fe
    style E9 fill:#c8e6c9
    style BM fill:#ffcdd2
    style INIT_SEQ fill:#f3e5f5
    style INPUT_PROCESSING fill:#e8f5e8
    style AUTONOMOUS fill:#fff3e0
    style AGENTS fill:#fce4ec
    style UI fill:#e0f2f1
    classDef critical fill:#ff9800,stroke:#d32f2f,stroke-width:3px
    class E5 critical
