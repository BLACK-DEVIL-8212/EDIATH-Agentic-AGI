#:kivy 2.1.0

# =========================================================
# EDIATH PRODUCTION UI LAYOUT
# Fully Fixed + Responsive + Modernized
# =========================================================

<RootLayout@BoxLayout>:

    orientation: 'vertical'
    spacing: 6
    padding: 6

    canvas.before:
        Color:
            rgba: 0.05, 0.05, 0.07, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # =====================================================
    # MAIN CONTENT
    # =====================================================
    BoxLayout:
        orientation: 'horizontal'
        spacing: 8

        # =================================================
        # LEFT SIDEBAR
        # =================================================
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.22
            spacing: 8

            # ---------------------------------------------
            # HEADER
            # ---------------------------------------------
            BoxLayout:
                size_hint_y: 0.1
                padding: 5

                canvas.before:
                    Color:
                        rgba: 0.1, 0.1, 0.14, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]

                Label:
                    text: "EDIATH AI"
                    bold: True
                    font_size: "22sp"
                    color: 0.2, 0.8, 1, 1

            # ---------------------------------------------
            # AVATAR PANEL
            # ---------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.45
                padding: 5

                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.12, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]

                Label:
                    text: "Avatar Window"
                    font_size: "20sp"
                    bold: True
                    color: 1, 1, 1, 1

                Widget:

            # ---------------------------------------------
            # PLANNING PANEL
            # ---------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.45
                padding: 10
                spacing: 8

                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.12, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]

                Label:
                    text: "Planning Steps"
                    bold: True
                    font_size: "18sp"
                    size_hint_y: 0.15
                    color: 1, 1, 1, 1

                ScrollView:

                    Label:
                        text:
                            "• Initialize System\\n"
                            "• Load Configuration\\n"
                            "• Establish Connections\\n"
                            "• Prepare AI Models\\n"
                            "• Ready For Input"
                        font_size: "16sp"
                        valign: "top"
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        color: 0.8, 0.8, 0.9, 1

        # =================================================
        # CENTER CHAT PANEL
        # =================================================
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.56
            spacing: 8

            # ---------------------------------------------
            # CHAT HEADER
            # ---------------------------------------------
            BoxLayout:
                size_hint_y: 0.1
                padding: 8

                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.12, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14]

                Label:
                    text: "EDIATH Intelligent Assistant"
                    bold: True
                    font_size: "22sp"
                    color: 0.2, 0.8, 1, 1

            # ---------------------------------------------
            # CHAT AREA
            # ---------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.78
                padding: 10

                canvas.before:
                    Color:
                        rgba: 0.07, 0.07, 0.1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]

                ScrollView:

                    Label:
                        id: chat_output

                        text:
                            "[b]EDIATH:[/b]\\n"
                            "Hello! I'm EDIATH, your intelligent assistant.\\n"
                            "How can I help you today?"

                        markup: True
                        font_size: "18sp"
                        text_size: self.width - 20, None
                        size_hint_y: None
                        height: self.texture_size[1] + 20
                        valign: "top"
                        halign: "left"
                        color: 1, 1, 1, 1

            # ---------------------------------------------
            # INPUT BAR
            # ---------------------------------------------
            BoxLayout:
                size_hint_y: 0.12
                spacing: 8

                TextInput:
                    id: user_input

                    hint_text: "Type your message..."
                    multiline: False
                    font_size: "18sp"
                    padding: [12, 12]
                    background_color: 0.12, 0.12, 0.16, 1
                    foreground_color: 1, 1, 1, 1
                    cursor_color: 0.2, 0.8, 1, 1

                Button:
                    text: "Send"
                    size_hint_x: 0.22
                    bold: True
                    font_size: "18sp"
                    background_normal: ''
                    background_color: 0.15, 0.55, 1, 1
                    color: 1, 1, 1, 1

        # =================================================
        # RIGHT PANEL
        # =================================================
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.22
            spacing: 8

            # ---------------------------------------------
            # MEMORY PANEL
            # ---------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.42
                padding: 8

                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.12, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]

                Label:
                    text: "Memory Usage"
                    bold: True
                    font_size: "18sp"
                    size_hint_y: 0.15
                    color: 1, 1, 1, 1

                ProgressBar:
                    max: 100
                    value: 42

                Label:
                    text: "RAM Usage: 42%"
                    font_size: "16sp"
                    color: 0.8, 0.8, 0.9, 1

                Widget:

            # ---------------------------------------------
            # SYSTEM STATS
            # ---------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.58
                padding: 10
                spacing: 10

                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.12, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]

                Label:
                    text: "System Statistics"
                    bold: True
                    font_size: "18sp"
                    size_hint_y: 0.12
                    color: 1, 1, 1, 1

                Label:
                    text:
                        "CPU Usage: 12%\\n\\n"
                        "GPU Usage: 28%\\n\\n"
                        "Memory Usage: 42%\\n\\n"
                        "Agents Online: 17"
                    font_size: "16sp"
                    halign: "left"
                    valign: "top"
                    text_size: self.width - 20, None
                    color: 0.8, 0.8, 0.9, 1

    # =====================================================
    # BOTTOM STATUS BAR
    # =====================================================
    BoxLayout:
        size_hint_y: 0.08
        spacing: 15
        padding: [12, 6]

        canvas.before:
            Color:
                rgba: 0.08, 0.08, 0.1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]

        Label:
            text: "🟢 Ready"
            font_size: "16sp"
            color: 0.3, 1, 0.4, 1

        Label:
            text: "Task: Idle"
            font_size: "16sp"
            color: 1, 1, 1, 1

        Label:
            text: "AI Connected"
            font_size: "16sp"
            color: 0.2, 0.8, 1, 1

        Label:
            text: "GPU Active"
            font_size: "16sp"
            color: 1, 0.8, 0.2, 1

        Label:
            text: "Current Task: None"
            font_size: "16sp"
            color: 1, 1, 1, 1